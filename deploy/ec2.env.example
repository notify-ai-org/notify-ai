# Copy to /opt/vocab-agent/.env on the EC2 host. Do not commit the real file.
# Host networking lets the application reach PostgreSQL on the EC2 host using
# the same loopback address permitted by pg_hba.conf.
SPRING_PROFILES_ACTIVE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=notify_db
DB_USER=notification_user
DB_PASSWORD=replace-with-a-secret

# Optional: choose Hibernate's schema policy for this environment.
DDL_AUTO=validate
