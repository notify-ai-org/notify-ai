# Copy this file to deploy/ec2.env on the EC2 instance and fill in secrets.
# deploy/ec2.env is intentionally ignored by git.

# Firebase Cloud Messaging. The credentials path is inside the application container.
# Mount your Google credentials file read-only at this path; see engine documentation.
PUSH_ENABLED=true

# Meta WhatsApp Cloud API. Select a supported Graph API version in your Meta app.
WHATSAPP_ENABLED=true

DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
OPENAI_API_KEY=sk-change-me
GROQ_API_KEY=gsk-change-me
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# App and public origin
SERVER_PORT=8080
MANAGEMENT_PORT=8081
ACP_CORS_ALLOWED_ORIGINS=https://app.notify-ai.dev
SPRING_WEBFLUX_CORS_ALLOWED_ORIGINS=https://app.notify-ai.dev

# Embeddings use OpenAI's embeddings endpoint by default.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODELS=text-embedding-3-small
EMBEDDING_QUERY_MODEL=text-embedding-3-small
EMBEDDING_API_PATH=/embeddings

# Enable after migration 002, channel provisioning and IAM/KMS setup.
NOTIFICATION_SECRETS_ENABLED=false
NOTIFICATION_SECRETS_KMS_KEY_ID=
NOTIFICATION_SECRETS_ROLE_ARN=
NOTIFICATION_SECRETS_CACHE_ENABLED=false
NOTIFY_ENVIRONMENT=production
NOTIFICATION_SECRETS_RUNTIME_ROLE_ARN=
