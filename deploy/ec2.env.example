# Copy this file to deploy/ec2.env on the EC2 instance and fill in secrets.
# deploy/ec2.env is intentionally ignored by git.

DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
OPENAI_API_KEY=sk-change-me

# App and public origin
SERVER_PORT=8080
MANAGEMENT_PORT=8081
ACP_CORS_ALLOWED_ORIGINS=https://app.notify-ai.dev
SPRING_WEBFLUX_CORS_ALLOWED_ORIGINS=https://app.notify-ai.dev

# Ollama runs as the notify-ollama container in docker-compose.yml.
OLLAMA_HOST=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=900

# Embeddings use Ollama's native /api/embed endpoint by default.
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_API_KEY=
EMBEDDING_MODELS=nomic-embed-text
EMBEDDING_QUERY_MODEL=nomic-embed-text
EMBEDDING_API_PATH=/api/embed
