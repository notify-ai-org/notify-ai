{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/NotifySecretService"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "TenantId",
            "ChannelId"
          ]
        },
        "Null": {
          "aws:RequestTag/TenantId": "false",
          "aws:RequestTag/ChannelId": "false"
        }
      }
    }
  ]
}
