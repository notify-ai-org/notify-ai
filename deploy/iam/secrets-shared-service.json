{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Service": "notification-engine",
          "aws:ResourceTag/Environment": "ENVIRONMENT"
        }
      }
    },
    {
      "Sid": "ManageExistingNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:RotateSecret",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Service": "notification-engine",
          "aws:ResourceTag/Environment": "ENVIRONMENT"
        }
      }
    },
    {
      "Sid": "CreateTaggedNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Service": "notification-engine",
          "aws:RequestTag/Environment": "ENVIRONMENT"
        },
        "Null": {
          "aws:RequestTag/TenantId": "false",
          "aws:RequestTag/ChannelId": "false",
          "aws:RequestTag/SecretRef": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "TenantId",
            "ChannelId",
            "SecretRef",
            "Environment",
            "Service"
          ]
        }
      }
    },
    {
      "Sid": "KmsOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY_ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.REGION.amazonaws.com",
          "kms:CallerAccount": "ACCOUNT_ID"
        },
        "ArnLike": {
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*"
        }
      }
    },
    {
      "Sid": "NeverForceDelete",
      "Effect": "Deny",
      "Action": "secretsmanager:DeleteSecret",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*",
      "Condition": {
        "Bool": {
          "secretsmanager:ForceDeleteWithoutRecovery": "true"
        }
      }
    }
  ]
}
