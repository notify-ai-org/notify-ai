{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Service": "notification-engine",
          "aws:ResourceTag/Environment": "default",
          "aws:ResourceTag/TenantId": "${aws:PrincipalTag/TenantId}",
          "aws:ResourceTag/ChannelId": "${aws:PrincipalTag/ChannelId}"
        }
      }
    },
    {
      "Sid": "DescribeNotifySecretsForReconciliation",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/${aws:PrincipalTag/TenantId}/${aws:PrincipalTag/ChannelId}/*",
      "Condition": {
        "Null": {
          "aws:PrincipalTag/TenantId": "false",
          "aws:PrincipalTag/ChannelId": "false"
        }
      }
    },
    {
      "Sid": "ManageExistingNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:RotateSecret",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Service": "notification-engine",
          "aws:ResourceTag/Environment": "default",
          "aws:ResourceTag/TenantId": "${aws:PrincipalTag/TenantId}",
          "aws:ResourceTag/ChannelId": "${aws:PrincipalTag/ChannelId}"
        }
      }
    },
    {
      "Sid": "CreateTaggedNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/${aws:PrincipalTag/TenantId}/${aws:PrincipalTag/ChannelId}/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Service": "notification-engine",
          "aws:RequestTag/Environment": "default",
          "aws:RequestTag/TenantId": "${aws:PrincipalTag/TenantId}",
          "aws:RequestTag/ChannelId": "${aws:PrincipalTag/ChannelId}"
        },
        "Null": {
          "aws:RequestTag/TenantId": "false",
          "aws:RequestTag/ChannelId": "false",
          "aws:RequestTag/SecretRef": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "TenantId",
            "ChannelId",
            "SecretRef",
            "Environment",
            "Service"
          ]
        }
      }
    },
    {
      "Sid": "KmsOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:ap-south-1:563147319972:key/dfced567-15e7-441e-a091-a6a220377a9c",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com",
          "kms:CallerAccount": "563147319972"
        },
        "ArnLike": {
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/*"
        }
      }
    },
    {
      "Sid": "NeverForceDelete",
      "Effect": "Deny",
      "Action": "secretsmanager:DeleteSecret",
      "Resource": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/*",
      "Condition": {
        "Bool": {
          "secretsmanager:ForceDeleteWithoutRecovery": "true"
        }
      }
    }
  ]
}
