{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Service": "notification-engine",
          "aws:ResourceTag/Environment": "default",
          "aws:ResourceTag/TenantId": "${aws:PrincipalTag/TenantId}",
          "aws:ResourceTag/ChannelId": "${aws:PrincipalTag/ChannelId}"
        }
      }
    },
    {
      "Sid": "KmsOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:ap-south-1:563147319972:key/dfced567-15e7-441e-a091-a6a220377a9c",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com",
          "kms:CallerAccount": "563147319972"
        },
        "ArnLike": {
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:ap-south-1:563147319972:secret:notification-engine/default/*"
        }
      }
    }
  ]
}
