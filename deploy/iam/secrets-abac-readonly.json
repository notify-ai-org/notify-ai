{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNotifySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Service": "notification-engine",
          "aws:ResourceTag/Environment": "ENVIRONMENT",
          "aws:ResourceTag/TenantId": "${aws:PrincipalTag/TenantId}",
          "aws:ResourceTag/ChannelId": "${aws:PrincipalTag/ChannelId}"
        }
      }
    },
    {
      "Sid": "KmsOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY_ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.REGION.amazonaws.com",
          "kms:CallerAccount": "ACCOUNT_ID"
        },
        "ArnLike": {
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:notification-engine/ENVIRONMENT/*"
        }
      }
    }
  ]
}
