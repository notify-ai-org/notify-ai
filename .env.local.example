# Copy this file to .env.local, which Git ignores.
# In VS Code, launch "Notify Access" to load the file.
# Replace the two values below with credentials for your AWS caller identity.
# For the configured role trust policies, that identity is notify_admin.
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
# If using temporary credentials, also supply their session token:
# AWS_SESSION_TOKEN=REPLACE_WITH_SESSION_TOKEN
